{
  "sources": {
    "obsidian-kit": {
      "ref": "0.95.0"
    },
    "code-kit": {
      "ref": "0.75.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "crc32",
        "filename-template",
        "folder-scope",
        "fold-case",
        "heading-title",
        "i18n",
        "link-resolver",
        "name-order",
        "rel-path",
        "settings",
        "split-list",
        "run-exclusive"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "frontmatter",
        "frontmatter-patch",
        "vault-path"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "./"
        ],
        [
          "../pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "settings_walker",
        "folder-suggest",
        "help-setting",
        "share-export",
        "confirm",
        "status-indicator",
        "setting-body-host"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "kit-css",
        "linear-probe"
      ]
    }
  ]
}
